# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB connection string (Atlas or self-hosted), used by the auth API
# routes (src/app/api/auth/*) via src/lib/mongodb.js.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/stillpoint?retryWrites=true&w=majority

# Secret used to sign/verify the auth JWT stored in the httpOnly session
# cookie (src/lib/auth.js). Use a long, random value in production, e.g.
# `openssl rand -base64 48`.
JWT_SECRET=replace-this-with-a-long-random-string

# Gemini API key used by /api/support to generate cloud responses for
# signed-in users. Held ONLY on the server — never sent to the browser.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Vercel Redis / KV integration
# To get these values, add a Redis or KV database in your Vercel project:
# 1. Open your project in Vercel.
# 2. Go to Storage > Create > Redis or KV.
# 3. Create the database and connect it to this project.
# 4. After it is created, open the database details and copy the generated
#    environment variables from the "Environment Variables" or "Connect" section.
# 5. Paste those values here.
#

# These values are usually generated automatically by the Vercel integration.
KV_REST_API_READ_ONLY_TOKEN=""
KV_REST_API_TOKEN=""
KV_REST_API_URL=""
KV_URL=""
REDIS_URL=""
VERCEL_OIDC_TOKEN=""

# NOPE API for safety evaluation and crisis resources
NOPE_BASE_URL="https://api.nope.net"
NOPE_API_KEY=your-nope-api-key-here
